{
  "name": "moodle-ai-reviewer",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrom",
    "dev:firefox": "wxt -b firefox",
    "build:chrome": "wxt build -b chrom",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build-all": "npm run build:chrome && npm run build:firefox && npm run build:edge",
    "zip:chrome": "wxt zip -b chrom",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "web-ext lint --source-dir=Erweiterung/moodle-ai-reviewer-chrom && web-ext lint --source-dir=Erweiterung/moodle-ai-reviewer-firefox",
    "postinstall": "wxt prepare",
    "paket": "bash scripts/paketieren.sh",
    "sign:firefox": "web-ext sign --source-dir=Erweiterung/moodle-ai-reviewer-firefox --artifacts-dir=web-ext-artifacts --channel=unlisted"
  },
  "devDependencies": {
    "wxt": "^0.21.4",
    "web-ext": "^10.6.0"
  }
}
