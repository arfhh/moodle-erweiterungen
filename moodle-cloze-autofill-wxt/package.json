{
  "name": "moodle-cloze-autofill",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrom",
    "dev:firefox": "wxt -b firefox",
    "build:chrome": "wxt build -b chrom",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build-all": "npm run build:chrome && npm run build:firefox && npm run build:edge",
    "zip:chrome": "wxt zip -b chrom",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "web-ext lint --source-dir=Erweiterung/moodle-cloze-autofill-chrom && web-ext lint --source-dir=Erweiterung/moodle-cloze-autofill-firefox",
    "postinstall": "wxt prepare",
    "paket": "bash scripts/paketieren.sh",
    "sign:firefox": "web-ext sign --source-dir=Erweiterung/moodle-cloze-autofill-firefox --artifacts-dir=web-ext-artifacts --channel=unlisted"
  },
  "devDependencies": {
    "wxt": "^0.21.4",
    "web-ext": "^10.6.0"
  }
}
